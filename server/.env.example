# Provided automatically by Railway when you add a PostgreSQL service.
# In Railway: Variables > Add Reference > Postgres > DATABASE_URL
DATABASE_URL=postgresql://user:pass@host:5432/railway

# REQUIRED. Generate with: openssl rand -base64 48
#JWT_SECRET=replace-with-a-long-random-string-at-least-24-chars
JWT_SECRET=NZVJFENCFEZJNRJEZNJLZNZC

# The first person to sign up with this address becomes an approved admin.
ADMIN_EMAIL=kacem.lachkar@talan.com

# Only this email domain may register.
ALLOWED_EMAIL_DOMAIN=talan.com

# Your Vercel URL(s), comma separated. No trailing slash.
CORS_ORIGIN=https://talan-academy.vercel.app

# Optional
# ALLOW_VERCEL_PREVIEWS=true
# TOKEN_TTL=12h
# RATE_LIMIT_SCALE=1
